<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="uneven_terrain">
    <physics name="1ms" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="libignition-gazebo-physics-system.so" name="gz::sim::systems::Physics">
    </plugin>
    <plugin filename="libignition-gazebo-sensors-system.so" name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="libignition-gazebo-scene-broadcaster-system.so" name="ignition::gazebo::systems::SceneBroadcaster">
    </plugin>
    <plugin filename="libignition-gazebo-user-commands-system.so" name="gz::sim::systems::UserCommands">
    </plugin>
    <plugin filename="libignition-gazebo-imu-system.so" name="ignition::gazebo::systems::Imu">
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>1 1 1 1</diffuse>
      <specular>0.5 0.5 0.5 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <scene>
      <grid>false</grid>
    </scene>

    <model name="uneven_terrain_complete">
      <static>true</static>
      <pose>0 5 0 1.57079632679 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <polyline>
              <!-- Outer Profile (Left to Right) -->
              <point>-5.1 1.66</point>              <!-- West Wall Top Out -->
              <point>-4.9 1.66</point>              <!-- West Wall Top In -->
              <point>-4.9 -0.34</point>              <!-- West Wall Base -->
              <point>-3.63 -0.34</point>              <!-- Ramp Start -->
              <point>-1.463 0.0</point>              <!-- Platform Start -->
              <point>1.537 0.0</point>              <!-- Platform End -->
              <point>3.71 -0.34</point>              <!-- Ramp End -->
              <point>4.9 -0.34</point>              <!-- East Wall Base -->
              <point>4.9 1.66</point>              <!-- East Wall Top In -->
              <point>5.1 1.66</point>              <!-- East Wall Top Out -->

              <!-- Inner Profile (Right to Left, ~0.1 thickness shell) -->
              <point>5.1 -0.5</point>              <!-- East Wall Bottom Out -->
              <point>4.9 -0.44</point>              <!-- East Wall Bottom In -->
              <point>3.71 -0.44</point>              <!-- Ramp Under -->
              <point>1.537 -0.1</point>              <!-- Platform Under -->
              <point>-1.463 -0.1</point>              <!-- Platform Under -->
              <point>-3.63 -0.44</point>              <!-- Ramp Under -->
              <point>-4.9 -0.44</point>              <!-- West Wall Bottom In -->
              <point>-5.1 -0.5</point>              <!-- West Wall Bottom Out -->

              <height>10.0</height>
            </polyline>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <polyline>
              <!-- Outer Profile (Left to Right) -->
              <point>-5.1 1.66</point>
              <point>-4.9 1.66</point>
              <point>-4.9 -0.34</point>
              <point>-3.63 -0.34</point>
              <point>-1.463 0.0</point>
              <point>1.537 0.0</point>
              <point>3.71 -0.34</point>
              <point>4.9 -0.34</point>
              <point>4.9 1.66</point>
              <point>5.1 1.66</point>

              <!-- Inner Profile (Right to Left) -->
              <point>5.1 -0.5</point>
              <point>4.9 -0.44</point>
              <point>3.71 -0.44</point>
              <point>1.537 -0.1</point>
              <point>-1.463 -0.1</point>
              <point>-3.63 -0.44</point>
              <point>-4.9 -0.44</point>
              <point>-5.1 -0.5</point>

              <height>10.0</height>
            </polyline>
          </geometry>
          <material>
            <ambient>0.6 0.6 0.6 1</ambient>
            <diffuse>0.6 0.6 0.6 1</diffuse>
          </material>
        </visual>

        <!-- North Wall (World Y=5, Local Z=0) -->
        <collision name="collision_wall_north">
          <pose>0 0 0 0 0 0</pose>          <!-- Relative to Link Frame -->
          <!-- Link Frame is at World 0,5,0. Rotated -90 X. -->
          <!-- Local X=X, Local Y=Z, Local Z=-Y -->
          <!-- We want World Y=5. This is Local Z=0? -->
          <!-- geometry <polyline> extrudes along Z. Height 10. -->
          <!-- It goes from Z=0 to Z=10. -->
          <!-- So Z=0 is one end (North), Z=10 is other end (South). -->
          <!-- Wall should be at Z=0. Thickness 0.2. So Center at Z=0.1? or Z=0 if overlapping. -->
          <!-- The polyline profile is in XY plane (of link). -->
          <!-- Visual Box: Size 10.2 (X) x 2 (Y/Height) x 0.2 (Z/Thickness) -->
          <geometry>
            <box>
              <size>10.2 2.16 0.2</size>
            </box>
          </geometry>
          <pose>0 0.58 0.1 0 0 0</pose>
          <!-- Y=0.58 (Vertical Center relative to profile ground). 
                Ground is ~ -0.34. Max Height 1.66. Top-Bottom = 2.0. Center ~ 0.66.
                Wait, Profile Y coords are -0.34 to 1.66. 
                Midpoint = (-0.34 + 1.66)/2 = 0.66.
                So Box Y center should be 0.66.
                Box Height (Y) = 2.0.
                ZCenter = 0.1 (Inside the start of extrusion).
            -->
        </collision>
        <visual name="visual_wall_north">
          <pose>0 0.66 0.1 0 0 0</pose>
          <geometry>
            <box>
              <size>10.2 2.0 0.2</size>
            </box>
          </geometry>
          <material>
            <ambient>0.6 0.6 0.6 1</ambient>
            <diffuse>0.6 0.6 0.6 1</diffuse>
          </material>
        </visual>

        <!-- South Wall (World Y=-5, Local Z=10) -->
        <collision name="collision_wall_south">
          <pose>0 0.66 9.9 0 0 0</pose>
          <geometry>
            <box>
              <size>10.2 2.0 0.2</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual_wall_south">
          <pose>0 0.66 9.9 0 0 0</pose>
          <geometry>
            <box>
              <size>10.2 2.0 0.2</size>
            </box>
          </geometry>
          <material>
            <ambient>0.6 0.6 0.6 1</ambient>
            <diffuse>0.6 0.6 0.6 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
