<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="uneven_terrain_polyline_big">
    <physics name="1ms" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="libignition-gazebo-physics-system.so" name="gz::sim::systems::Physics">
    </plugin>
    <plugin filename="libignition-gazebo-sensors-system.so" name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="libignition-gazebo-scene-broadcaster-system.so" name="ignition::gazebo::systems::SceneBroadcaster">
    </plugin>
    <plugin filename="libignition-gazebo-user-commands-system.so" name="gz::sim::systems::UserCommands">
    </plugin>
    <plugin filename="libignition-gazebo-imu-system.so" name="ignition::gazebo::systems::Imu">
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>1 1 1 1</diffuse>
      <specular>0.5 0.5 0.5 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <scene>
      <grid>false</grid>
    </scene>

    <model name="uneven_terrain_complete">
      <static>true</static>
      <pose>0 10 0 1.57079632679 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <polyline>
              <!-- Outer Profile (Left to Right) -->
              <point>-6.7 0.66</point>              <!-- West Wall Top Out -->
              <point>-6.5 0.66</point>              <!-- West Wall Top In -->
              <point>-6.5 -1.34</point>              <!-- West Wall Base / Ramp Start -->
              <point>-1.5 0.0</point>              <!-- Platform Start -->
              <point>1.5 0.0</point>              <!-- Platform End -->
              <point>6.5 -1.34</point>              <!-- East Wall Base / Ramp End -->
              <point>6.5 0.66</point>              <!-- East Wall Top In -->
              <point>6.7 0.66</point>              <!-- East Wall Top Out -->

              <!-- Inner Profile (Right to Left, ~0.1 thickness shell) -->
              <point>6.7 -1.5</point>              <!-- East Wall Bottom Out -->
              <point>6.5 -1.44</point>              <!-- East Wall Bottom In -->
              <point>1.5 -0.1</point>              <!-- Platform Under -->
              <point>-1.5 -0.1</point>              <!-- Platform Under -->
              <point>-6.5 -1.44</point>              <!-- West Wall Bottom In -->
              <point>-6.7 -1.5</point>              <!-- West Wall Bottom Out -->

              <height>20.0</height>
            </polyline>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <polyline>
              <!-- Outer Profile (Left to Right) -->
              <point>-6.7 0.66</point>
              <point>-6.5 0.66</point>
              <point>-6.5 -1.34</point>
              <point>-1.5 0.0</point>
              <point>1.5 0.0</point>
              <point>6.5 -1.34</point>
              <point>6.5 0.66</point>
              <point>6.7 0.66</point>

              <!-- Inner Profile (Right to Left) -->
              <point>6.7 -1.5</point>
              <point>6.5 -1.44</point>
              <point>1.5 -0.1</point>
              <point>-1.5 -0.1</point>
              <point>-6.5 -1.44</point>
              <point>-6.7 -1.5</point>

              <height>20.0</height>
            </polyline>
          </geometry>
          <material>
            <ambient>0.6 0.6 0.6 1</ambient>
            <diffuse>0.6 0.6 0.6 1</diffuse>
          </material>
        </visual>

        <!-- North Wall (World Y=10, Local Z=0) -->
        <collision name="collision_wall_north">
          <pose>0 -0.34 0.1 0 0 0</pose>          <!-- Relative to Link Frame -->
          <geometry>
            <box>
              <size>13.4 2.16 0.2</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual_wall_north">
          <pose>0 -0.34 0.1 0 0 0</pose>
          <geometry>
            <box>
              <size>13.4 2.0 0.2</size>
            </box>
          </geometry>
          <material>
            <ambient>0.6 0.6 0.6 1</ambient>
            <diffuse>0.6 0.6 0.6 1</diffuse>
          </material>
        </visual>

        <!-- South Wall (World Y=-10, Local Z=20) -->
        <collision name="collision_wall_south">
          <pose>0 -0.34 19.9 0 0 0</pose>
          <geometry>
            <box>
              <size>13.4 2.16 0.2</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual_wall_south">
          <pose>0 -0.34 19.9 0 0 0</pose>
          <geometry>
            <box>
              <size>13.4 2.0 0.2</size>
            </box>
          </geometry>
          <material>
            <ambient>0.6 0.6 0.6 1</ambient>
            <diffuse>0.6 0.6 0.6 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
