<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
    <name>sdf_to_nav_mesh</name>
    <version>1.0.0</version>
    <description>Standalone tool to convert Gazebo SDF/World files to Mesh Navigation PLY and H5 maps.</description>
    <maintainer email="thippe@example.com">thippe</maintainer>
    <license>BSD-3-Clause</license>

    <buildtool_depend>ament_python</buildtool_depend>

    <exec_depend>python3-h5py</exec_depend>
    <exec_depend>python3-numpy</exec_depend>
    <exec_depend>python3-scipy</exec_depend>
    <exec_depend>python3-shapely</exec_depend>
    <exec_depend>python3-trimesh</exec_depend>

    <test_depend>ament_copyright</test_depend>
    <test_depend>ament_flake8</test_depend>
    <test_depend>ament_pep257</test_depend>
    <test_depend>python3-pytest</test_depend>

    <export>
        <build_type>ament_python</build_type>
    </export>
</package>
